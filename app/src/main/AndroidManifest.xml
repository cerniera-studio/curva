<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- football-data.org, with the key you enter in settings -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The apps a Watch button can open -->
    <queries>
        <package android:name="com.bskyb.skygo" />
        <package android:name="com.amazon.avod.thirdpartyclient" />
        <package android:name="bbc.iplayer.android" />
        <package android:name="air.ITVMobilePlayer" />
    </queries>

    <application
        android:name=".CurvaApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.App"
        android:resizeableActivity="true">

        <!-- Folding and turning are handled in place: the panes lay themselves out again -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|uiMode|density|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
